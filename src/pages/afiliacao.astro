---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { hostedAsaasLink, publicHttpsLink } from '../lib/asaas-links';
const link = hostedAsaasLink(import.meta.env.PUBLIC_ASAAS_AFFILIATION_URL);
const privacy = publicHttpsLink(import.meta.env.PUBLIC_PRIVACY_URL);
const terms = publicHttpsLink(import.meta.env.PUBLIC_AFFILIATION_TERMS_URL);
---

<BaseLayout title="Quero me afiliar">
  <PageHeader
    eyebrow="Participe"
    title="Quero me afiliar"
    description="Participe da Federação das Mulheres."
  />
  <section class="section">
    <div class="container narrow prose">
      <p>
        A filiação prevê uma contribuição mensal. No fluxo hospedado pelo Asaas,
        você informa seus dados e realiza o pagamento de cada cobrança Pix. As
        cobranças seguintes são geradas mensalmente; o Pix comum não é debitado
        automaticamente.
      </p>
      <p>
        O pagamento e a análise institucional são etapas distintas. Uma
        contribuição paga não significa aprovação da filiação. O valor e as
        regras serão apresentados no Asaas quando aprovados e configurados pela
        Federação.
      </p>
      {
        link ? (
          <a class="button" href={link} rel="noopener noreferrer">
            Iniciar filiação no Asaas
          </a>
        ) : (
          <>
            <button class="button" type="button" disabled>
              Iniciar filiação no Asaas
            </button>
            <p class="unavailable" role="status">
              A filiação online está temporariamente indisponível. O link de
              pagamento ainda não foi validado e ativado.
            </p>
          </>
        )
      }
      <p class="legal-links">
        {
          privacy ? (
            <a href={privacy}>Política de privacidade</a>
          ) : (
            <span>Política de privacidade ainda não publicada.</span>
          )
        }
        {
          terms ? (
            <a href={terms}>Termos de filiação</a>
          ) : (
            <span>Termos de filiação ainda não publicados.</span>
          )
        }
      </p>
    </div>
  </section>
</BaseLayout>
