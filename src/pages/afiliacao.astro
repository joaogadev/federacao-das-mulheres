---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { hostedAsaasLink, publicHttpsLink } from '../lib/asaas-links';
import { getSite } from '../lib/content';
const site = await getSite();
const link =
  hostedAsaasLink(site.affiliationCheckoutUrl ?? undefined) ??
  hostedAsaasLink(import.meta.env.PUBLIC_ASAAS_AFFILIATION_URL);
const sandbox = link && new URL(link).hostname === 'sandbox.asaas.com';
const privacy =
  publicHttpsLink(site.privacyUrl ?? undefined) ??
  publicHttpsLink(import.meta.env.PUBLIC_PRIVACY_URL);
const terms =
  publicHttpsLink(site.affiliationTermsUrl ?? undefined) ??
  publicHttpsLink(import.meta.env.PUBLIC_AFFILIATION_TERMS_URL);
const amount = site.affiliationMonthlyAmount;
const formattedAmount = amount
  ? new Intl.NumberFormat('pt-BR', {
      style: 'currency',
      currency: 'BRL',
    }).format(amount)
  : null;
---

<BaseLayout title="Quero me afiliar">
  <PageHeader
    eyebrow="Participe"
    title="Quero me afiliar"
    description="Participe da Federação das Mulheres."
  />
  <section class="section">
    <div class="container narrow prose">
      {site.affiliationDescription && <p>{site.affiliationDescription}</p>}
      {
        site.affiliationBenefits?.length ? (
          <ul>
            {site.affiliationBenefits.map((benefit) => (
              <li>{benefit}</li>
            ))}
          </ul>
        ) : null
      }
      {
        formattedAmount && (
          <p>
            <strong>Contribuição mensal: {formattedAmount}</strong>
          </p>
        )
      }
      <p>
        A filiação prevê uma contribuição mensal. No fluxo hospedado pelo Asaas,
        você informa nome, documento, e-mail e telefone no formulário de
        pagamento e realiza o pagamento de cada cobrança Pix. As cobranças
        seguintes são geradas mensalmente; o Pix comum não é debitado
        automaticamente.
      </p>
      <p>
        Depois da confirmação do primeiro pagamento, seus dados de contato ficam
        disponíveis para a equipe no painel administrativo.
      </p>
      {
        site.affiliationPixInstructions && (
          <p>{site.affiliationPixInstructions}</p>
        )
      }
      {
        site.affiliationCancellationInstructions && (
          <p>{site.affiliationCancellationInstructions}</p>
        )
      }
      <p>
        O pagamento e a análise institucional são etapas distintas. Uma
        contribuição paga não significa aprovação da filiação. O valor e as
        regras serão apresentados no Asaas quando aprovados e configurados pela
        Federação.
      </p>
      {
        sandbox && (
          <p class="unavailable" role="status">
            Ambiente de testes do Asaas. Esta página não conclui uma filiação ou
            pagamento real.
          </p>
        )
      }
      {
        link ? (
          <a class="button" href={link} rel="noopener noreferrer">
            Iniciar filiação no Asaas
          </a>
        ) : (
          <>
            <button class="button" type="button" disabled>
              Iniciar filiação no Asaas
            </button>
            <p class="unavailable" role="status">
              A filiação online está temporariamente indisponível. O link de
              pagamento ainda não foi validado e ativado.
            </p>
          </>
        )
      }
      <p class="legal-links">
        {
          privacy ? (
            <a href={privacy}>Política de privacidade</a>
          ) : (
            <span>Política de privacidade ainda não publicada.</span>
          )
        }
        {
          terms ? (
            <a href={terms}>Termos de filiação</a>
          ) : (
            <span>Termos de filiação ainda não publicados.</span>
          )
        }
      </p>
    </div>
  </section>
</BaseLayout>
