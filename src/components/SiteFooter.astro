---
import { getSite } from '../lib/content';
const site = await getSite();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="footer-brand" href="/">{site.name}</a>
      <p>{site.intro}</p>
    </div>

    <div>
      <h2>Explore</h2>
      <a href="/sobre/">Quem somos</a>
      <a href="/noticias/">Notícias</a>
      <a href="/eventos/">Eventos</a>
      <a href="/projetos/">Projetos e ações</a>
      <a href="/admin/">Painel editorial</a>
    </div>

    <div>
      <h2>Fale conosco</h2>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <span>{site.address}</span>
      <a href="/contato/">Todos os contatos →</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} {site.name}</span>
    {
      process.env.CONTENT_SOURCE === 'demo' && (
        <span>Conteúdo demonstrativo para avaliação local.</span>
      )
    }
  </div>
</footer>
