---
interface Props {
  href: string;
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  meta?: string;
  kind?: string;
}

const { href, title, description, image, imageAlt, meta, kind } = Astro.props;
---

<article class="content-card">
  <a href={href} class="card-image" aria-label={`Leia mais: ${title}`}>
    {
      image ? (
        <img src={image} alt={imageAlt || ''} loading="lazy" />
      ) : (
        <span class="image-placeholder" aria-hidden="true">
          ✳
        </span>
      )
    }
  </a>
  <div class="card-body">
    <p class="card-meta">
      {kind && <span>{kind}</span>}
      {meta && <span>{meta}</span>}
    </p>
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
    <a class="text-link" href={href}>
      Saiba mais <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
