{
  "openapi": "3.0.0",
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "summary": "Login administrativo com limitação de tentativas",
        "parameters": [
          {
            "name": "origin",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDto"
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDto"
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ],
        "security": [
          {
            "cookie": []
          }
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "summary": "Invalida a sessão; requer X-CSRF-Token",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": [
          "auth"
        ],
        "security": [
          {
            "cookie": []
          }
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "AdminController_live",
        "summary": "Processo ativo",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "admin"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "AdminController_ready",
        "summary": "Banco disponível",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "admin"
        ]
      }
    },
    "/memberships": {
      "get": {
        "operationId": "AdminController_memberships",
        "summary": "Lista filiações",
        "parameters": [
          {
            "name": "financial",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "overdue",
                "received",
                "pending",
                "refunded"
              ],
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "PENDENTE",
                "APROVADA",
                "REPROVADA"
              ],
              "type": "string"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MembershipPageDto"
                }
              }
            }
          }
        },
        "tags": [
          "admin"
        ],
        "security": [
          {
            "cookie": []
          }
        ]
      }
    },
    "/memberships/{id}": {
      "get": {
        "operationId": "AdminController_membership",
        "summary": "Detalhe da filiação",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MembershipDto"
                }
              }
            }
          }
        },
        "tags": [
          "admin"
        ],
        "security": [
          {
            "cookie": []
          }
        ]
      }
    },
    "/memberships/{id}/decision": {
      "post": {
        "operationId": "AdminController_decision",
        "summary": "Decisão institucional; exige ADMIN e CSRF",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": [
          "admin"
        ],
        "security": [
          {
            "cookie": []
          }
        ]
      }
    },
    "/donations": {
      "get": {
        "operationId": "AdminController_donations",
        "summary": "Lista doações avulsas",
        "parameters": [
          {
            "name": "financial",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "overdue",
                "received",
                "pending",
                "refunded"
              ],
              "type": "string"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DonationPageDto"
                }
              }
            }
          }
        },
        "tags": [
          "admin"
        ],
        "security": [
          {
            "cookie": []
          }
        ]
      }
    },
    "/reports/summary": {
      "get": {
        "operationId": "AdminController_summary",
        "summary": "Indicadores separados por finalidade",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryDto"
                }
              }
            }
          }
        },
        "tags": [
          "admin"
        ],
        "security": [
          {
            "cookie": []
          }
        ]
      }
    },
    "/events": {
      "get": {
        "operationId": "AdminController_events",
        "summary": "Eventos com falha ou origem indefinida",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InboxEventDto"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "admin"
        ],
        "security": [
          {
            "cookie": []
          }
        ]
      }
    },
    "/events/{id}/retry": {
      "post": {
        "operationId": "AdminController_retry",
        "summary": "Reprocessar evento; exige ADMIN e CSRF",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": [
          "admin"
        ],
        "security": [
          {
            "cookie": []
          }
        ]
      }
    },
    "/sync/reconcile": {
      "post": {
        "operationId": "AdminController_reconcile",
        "summary": "Reconciliar com Asaas; exige ADMIN e CSRF",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": [
          "admin"
        ],
        "security": [
          {
            "cookie": []
          }
        ]
      }
    },
    "/webhooks/asaas": {
      "post": {
        "operationId": "WebhookController_receive",
        "summary": "Recebe e persiste evento Asaas; authToken no header asaas-access-token",
        "parameters": [
          {
            "name": "asaas-access-token",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AsaasWebhookDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
