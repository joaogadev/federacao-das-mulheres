{
  "name": "federacao-administrativo-api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/main.js",
    "check": "tsc --noEmit",
    "lint": "eslint src scripts --ext .ts",
    "test": "tsx --test tests/*.test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "admin:create": "node --env-file=.env --import tsx scripts/admin.ts create",
    "admin:create-consulta": "node --env-file=.env --import tsx scripts/admin.ts create-consulta",
    "admin:password": "node --env-file=.env --import tsx scripts/admin.ts password",
    "openapi:export": "node --env-file=.env dist/openapi-export.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.0",
    "@prisma/client": "^6.0.0",
    "argon2": "^0.41.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
