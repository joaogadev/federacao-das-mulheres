# Frontend: identificadores públicos; não precisa de token de leitura.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SITE_URL=https://seu-site.workers.dev
# Endereço do Studio hospedado pelo Sanity (não é o endereço do site).
PUBLIC_SANITY_STUDIO_URL=
# Somente para importação/verificação inicial local. Revogue após a migração.
# Não cadastrar no Cloudflare e nunca usar prefixo PUBLIC_ ou SANITY_STUDIO_.
SANITY_API_WRITE_TOKEN=
# URLs publicas de links distintos, ativadas apenas apos validacao no Sandbox.
PUBLIC_ASAAS_AFFILIATION_URL=
PUBLIC_ASAAS_DONATION_URL=
PUBLIC_PRIVACY_URL=
PUBLIC_AFFILIATION_TERMS_URL=
