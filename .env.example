# Frontend: identificadores públicos; não precisa de token de leitura.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SITE_URL=https://seu-site.workers.dev
# Opcional: substitui o Studio padrão federacao-mulheres-se.sanity.studio.
PUBLIC_SANITY_STUDIO_URL=
# Somente para importação/verificação inicial local. Revogue após a migração.
# Não cadastrar no Cloudflare e nunca usar prefixo PUBLIC_ ou SANITY_STUDIO_.
SANITY_API_WRITE_TOKEN=
# Checkout pessoal usado apenas no modo local de demonstracao.
# Em producao, configure checkout, valor, privacidade e termos no Sanity.
PUBLIC_AFFILIATION_URL=
PUBLIC_AFFILIATION_MODE=disabled
# Dados locais de teste: nao sao utilizados no build de producao.
TEST_AFFILIATION_AMOUNT=
TEST_DONATION_PIX_CODE=
